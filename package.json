{
  "name": "otomoto-hybrid-bot",
  "version": "1.0.0",
  "description": "Telegram-бот, що стежить за новими оголошеннями гібридів на Otomoto і оцінює їх за правилами",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node src/index.js",
    "dry": "DRY_RUN=1 node src/index.js",
    "local": "node --env-file=.env src/index.js",
    "parse": "node src/index.js --parse-file",
    "test": "node --test"
  },
  "license": "MIT"
}
